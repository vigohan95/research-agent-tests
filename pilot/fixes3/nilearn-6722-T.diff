+def _time_to_high_res_index(times, frame_times_high_res):
+    """Return the index of the first high resolution sample >= times.
+
+    Like ``np.searchsorted(frame_times_high_res, times)``, but a time lying
+    on a grid point up to floating point error is mapped to that grid
+    point. Otherwise ``k * t_r`` (onset of one event) and
+    ``(k - 1) * t_r + t_r`` (offset of the previous one) can land on
+    neighbouring samples, so that back-to-back events overlap or leave a
+    gap of one sample, which shows up as a ripple after convolution.
+    Indices are clipped to ``len(frame_times_high_res) - 1``.
+    """
+    step = (frame_times_high_res[-1] - frame_times_high_res[0]) / (
+        frame_times_high_res.size - 1
+    )
+    tolerance = 1e-6 * step
+    index = np.searchsorted(
+        frame_times_high_res, np.asarray(times, dtype=np.float64) - tolerance
+    )
+    return np.minimum(index, frame_times_high_res.size - 1)
 
 
