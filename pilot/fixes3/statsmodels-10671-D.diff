         pvalue = np.minimum(pvalue, 1)  # limit to 1 if n1==n2
     else:
         corr = int(correction)  # convert bool to 0 or 1
-        statistic = (np.abs(n1 - n2) - corr) ** 2 / (1.0 * (n1 + n2))
+        diff = np.abs(n1 - n2)
+        # The continuity correction must not overshoot zero; as in R's
